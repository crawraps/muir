{
  "typeface": {
    "plainFamily": "Geist, sans-serif",
    "brandFamily": "Inconsolata, sans-serif",
    "monospaceFamily": "Roboto Mono, monospace",
    "typeScale": {
      "body": {
        "large": { "lineHeight": 1.5, "size": 1.25, "weight": 600 },
        "medium": { "lineHeight": 1.5, "size": 1, "weight": 400 },
        "small": { "lineHeight": 1.5, "size": 0.875, "weight": 300 }
      },
      "display": {
        "large": { "lineHeight": 1.2, "size": 3, "weight": 700 },
        "medium": { "lineHeight": 1.2, "size": 2.625, "weight": 600 },
        "small": { "lineHeight": 1.2, "size": 2.25, "weight": 500 }
      },
      "headline": {
        "large": { "lineHeight": 1.2, "size": 3.25, "weight": 400 },
        "medium": { "lineHeight": 1.2, "size": 1.75, "weight": 400 },
        "small": { "lineHeight": 1.2, "size": 1.5, "weight": 500 }
      },
      "label": {
        "large": { "lineHeight": 1.3, "size": 1.25, "weight": 600 },
        "medium": { "lineHeight": 1.3, "size": 1, "weight": 500 },
        "small": { "lineHeight": 1.3, "size": 0.875, "weight": 400 }
      },
      "title": {
        "large": { "lineHeight": 1.4, "size": 1.75, "weight": 800 },
        "medium": { "lineHeight": 1.4, "size": 1.5, "weight": 700 },
        "small": { "lineHeight": 1.4, "size": 1.25, "weight": 600 }
      }
    }
  },
  "surface": {
    "type": "crust"
  }
}
