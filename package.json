{
  "name": "muir",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.3.14",
    "@changesets/changelog-git": "^0.2.0",
    "@changesets/cli": "^2.27.0",
    "@rstest/adapter-rsbuild": "^0.10.6",
    "turbo": "^2.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean && rm -rf .turbo .cache node_modules/.cache",
    "dev": "turbo run dev --filter=muir-docs",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "biome format --write",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "agent:create": "bun scripts/agent.ts create",
    "agent:remove": "bun scripts/agent.ts remove",
    "agent:list": "bun scripts/agent.ts list",
    "agent:run": "bun scripts/agent.ts run",
    "agent:sync": "bun scripts/agent.ts sync"
  }
}
